#!/bin/sh
# Fake Antigravity CLI (agy) for tests. Mimics the stream-json session mode:
# reads {"event":"user","message":{"content":...}} lines on stdin and writes
# NDJSON events, ending the turn with {"event":"result","result":{...}}.
# `agy models` is the sign-in check, as in agy 1.3: it lists models with exit
# 0 when signed in and exits 1 with "Please sign in" otherwise.
# Env: FAKE_MODE (ok|error|error_exit|malformed|noresult|fail|hang),
#      FAKE_AUTH (ok|missing|nokey), FAKE_ARGS/FAKE_STDIN, FAKE_CHILD.
set -u
[ -n "${FAKE_ARGS:-}" ] && printf '%s\n' "$@" > "$FAKE_ARGS"
[ "${1:-}" = --version ] && { echo "1.3.3"; exit 0; }
if [ "${1:-}" = models ]; then
	echo "Fetching available models..." >&2
	case "${FAKE_AUTH:-ok}" in
	ok) printf 'gemini-3.8-flash-high\tGemini 3.8 Flash (High)\ngemini-3.1-pro-high\tGemini 3.1 Pro (High)\n'; exit 0 ;;
	nokey) echo 'modelProvider is set to "gemini" in settings.json, but the GEMINI_API_KEY environment variable is not set.' >&2; exit 1 ;;
	*) echo "Error: Please sign in to view available models. Launch the CLI without arguments to sign in." >&2; exit 1 ;;
	esac
fi
in="" out=""
while [ $# -gt 0 ]; do
	case "$1" in
	--input-format) in=$2; shift ;;
	--output-format) out=$2; shift ;;
	--model) shift ;;
	*) echo "unknown flag: $1" >&2; exit 2 ;;
	esac
	shift
done
[ "$in" = stream-json ] && [ "$out" = stream-json ] || { echo "expected stream-json in and out" >&2; exit 2; }
IFS= read -r line
[ -n "${FAKE_STDIN:-}" ] && printf '%s\n' "$line" > "$FAKE_STDIN"
case "$line" in
'{"event":"user","message":{"content":'*'}}') ;;
*) echo '{"event":"result","result":{"status":"ERROR","error":"invalid input event"}}'; exit 1 ;;
esac
echo '{"event":"init","session_id":"s-1","model":"gemini-3.1-pro-high"}'
case "${FAKE_MODE:-ok}" in
ok)
	echo '{"event":"step_update","step_update":{"text_delta":"thinking"}}'
	printf '{"event":"result","result":{"status":"SUCCESS","response":"agy read %s bytes"}}\n' "${#line}" ;;
error) echo '{"event":"result","result":{"status":"ERROR","response":"","error":"quota exhausted"}}' ;;
error_exit) echo '{"event":"result","result":{"status":"ERROR","response":"","error":"authentication required"}}'; exit 1 ;;
malformed) echo 'log: not json'; echo '{"event":"result","result":{"status":"SUCC' ;;
noresult) echo '{"event":"step_update","step_update":{"text_delta":"partial"}}' ;;
fail) echo "panic: keyring unavailable" >&2; exit 3 ;;
hang) sleep 30 & echo $! > "$FAKE_CHILD"; wait ;;
esac
